{
  "id": "game-over",
  "name": "GameOver",
  "version": "1.0.0",
  "description": "Game over con continue a tempo (CONFIG.continueTimeout); se il punteggio entra in classifica mostra l'inserimento delle iniziali (blocco score-entry) e salva la top ten.",
  "scene": "GameOverScene",
  "factory": "createGameOverScene",
  "entry": "index.js",
  "requires": [
    "Phaser",
    "CONFIG",
    "GAME_STATE",
    "GAME_FONT",
    "TRANSLATIONS",
    "hasStartAccessForPlayers",
    "consumeCreditsForPlayers",
    "clearRuntimeMatchStorage",
    "kitFlow",
    "kitGame",
    "createNameEntry",
    "isHighScore",
    "insertTopScore",
    "saveTopScores"
  ],
  "events": {
    "end": "Partita finita, punteggio salvato",
    "exit": "Uscita senza classifica (anche dopo CONFIG.continueTimeout senza continue)"
  },
  "config": [
    "attractOverlayAlpha",
    "continueTimeout",
    "height",
    "width"
  ],
  "i18n": [
    "continue",
    "continue_q",
    "enterName",
    "gameOver",
    "gameOverText",
    "game_over",
    "press1_to_continue",
    "press2_to_continue",
    "score",
    "score_label",
    "time_left"
  ],
  "assets": {
    "textures": [],
    "audio": []
  },
  "uses": [
    "score-entry"
  ]
}
