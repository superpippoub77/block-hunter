{
  "game": {
    "id": "block-hunter",
    "title": "Block Hunter",
    "storagePrefix": "blockHunter"
  },
  "kitPath": "kit",
  "blocks": [
    "attract",
    "language",
    "top-ten",
    "credits",
    "config",
    "controls",
    "level-select",
    "game-over",
    "score-entry",
    "screen"
  ],
  "screens": {
    "AttractScene": {
      "id": "attract",
      "src": "data/screens/attract.json"
    },
    "InstructionsScene": {
      "id": "instructions",
      "src": "data/screens/instructions.json"
    },
    "TopTenScene": {
      "id": "top-ten",
      "src": "data/screens/top-ten.json"
    },
    "LevelSelectScene": {
      "id": "level-select",
      "src": "data/screens/level-select.json"
    }
  },
  "roles": {
    "gameplay": "GameScene"
  },
  "flow": {
    "attract": {
      "start": "LevelSelectScene",
      "idle": "InstructionsScene",
      "config": "ConfigScene"
    },
    "top-ten": {
      "timeout": "CreditsScene",
      "start": "LevelSelectScene",
      "exit": "AttractScene"
    },
    "credits": {
      "timeout": "AttractScene",
      "start": "LevelSelectScene",
      "exit": "AttractScene"
    },
    "config": {
      "exit": "AttractScene"
    },
    "level-select": {
      "start": "GameScene"
    },
    "game-over": {
      "end": "TopTenScene",
      "exit": "AttractScene"
    },
    "gameplay": {
      "gameover": "GameOverScene"
    },
    "instructions": {
      "timeout": "TopTenScene",
      "start": "LevelSelectScene",
      "config": "ConfigScene"
    },
    "controls": {
      "exit": "ConfigScene"
    }
  }
}
