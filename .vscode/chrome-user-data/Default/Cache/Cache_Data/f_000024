        function showAttractUI(scene) {
            if (!attractContainer) initAttractUI(scene);
            if (attractVisible && attractContainer.visible) return;
            // Hide topTen first
            if (topTenContainer && topTenContainer.visible) {
                scene.tweens.add({ targets: topTenContainer, alpha: 0, duration: 500, onComplete: () => topTenContainer.setVisible(false) });
            }

            attractContainer.setVisible(true);
            scene.tweens.add({ targets: attractContainer, alpha: 1, duration: 600 });
            attractVisible = true;

            // (re)start alternation timer
            if (!attractCycleEvent) {
                attractCycleEvent = scene.time.addEvent({
                    delay: 10000,
                    loop: true,
                    callback: () => {
                        // toggle
                        if (attractVisible) showTopTenUI(scene);
                        else showAttractUI(scene);
                    }
                });
            }
        }

        function hideAttractUI(scene, immediate = false) {
            if (!attractContainer) return;
            if (immediate) {
                attractContainer.setVisible(false);
                attractContainer.setAlpha(0);
            } else {
                scene.tweens.add({ targets: attractContainer, alpha: 0, duration: 400, onComplete: () => attractContainer.setVisible(false) });
            }
            attractVisible = false;
        }

        function showTopTenUI(scene) {
            if (!topTenContainer) initAttractUI(scene);
            // Hide attract
            if (attractContainer && attractContainer.visible) {
                scene.tweens.add({ targets: attractContainer, alpha: 0, duration: 500, onComplete: () => attractContainer.setVisible(false) });
            }
            // Show topTen
            topTenContainer.setVisible(true);
            scene.tweens.add({ targets: topTenContainer, alpha: 1, duration: 600 });
            attractVisible = false;
        }

        // Update credits display on attract/top-ten
        function refreshAttractPlayerHintsPhaser(scene) {
            try {
                // update footer / credits text
                if (topTenCreditsFooter) {
                    const label = (window.DICT && (window.DICT.credits_word || window.DICT.credits_label)) || 'CREDITI';
                    topTenCreditsFooter.setText((credits && credits > 0) ? `${label}: ${credits}` : (window.DICT && window.DICT.insert_coin) || 'INSERISCI MONETA');
                }
                // if attractContainer exists, try to update start button text
                if (langStartText) {
                    const insertCoin = (window.DICT && (window.DICT.insert_coin || window.DICT.insert_coin_btn)) || 'INSERISCI MONETA';
                    langStartText.setText((credits && credits > 0) ? `${(window.DICT && window.DICT.credits_word) || 'CREDITI'}: ${credits}` : insertCoin);
                }
                // update select overlay credits if visible
                if (selectCreditsText) {
                    try { selectCreditsText.setText((credits && credits > 0) ? `CREDITI: ${credits}` : ((window.DICT && window.DICT.insert_coin) || 'INSERISCI MONETA')); } catch (e) { }
                }
                // optionally update any visible hints (we don't have static DOM hints here)
            } catch (e) { /* ignore */ }
            try {
                // show player indicators depending on credits
                const hasP1 = (credits || 0) >= (CREDITS_PER_PLAYER || 1);
                const hasP2 = (credits || 0) >= ((CREDITS_PER_PLAYER || 1) * 2);
                if (playerIndicator1) playerIndicator1.setVisible(!!hasP1);
                if (playerIndicator2) playerIndicator2.setVisible(!!hasP2);
            } catch (e) { /* ignore overlay errors */ }
        }

        function insertCoin(amount = 1, scene) {
            credits = (credits || 0) + amount;
            // feedback (tween or sound)
            try { if (scene && scene.sound && scene.sound.play) scene.sound.play && scene.sound.play('coin'); } catch (e) { }
            refreshAttractPlayerHintsPhaser(scene || {});
            // small pulse on start button
            try {
                if (scene && langStartText && scene.tweens) {
                    scene.tweens.add({ targets: langStartText, scaleX: 1.05, scaleY: 1.05, yoyo: true, duration: 200 });
                }
            } catch (e) { }
        }

        function tryStartWithPlayers(n, scene) {
            const required = (CREDITS_PER_PLAYER || 1) * n;
            if ((credits || 0) >= required) {
                credits -= required;
                playersCount = n;
                refreshAttractPlayerHintsPhaser(scene);
                // start the game
                gameStarted = true;
                if (attractCycleEvent) { attractCycleEvent.remove(false); attractCycleEvent = null; }
                // restart the scene so create() goes into game state
                if (scene && scene.scene && scene.scene.restart) scene.scene.restart();
                // hide select overlay if open
                try { if (selectContainer) { selectContainer.destroy(true); selectContainer = null; } } catch (e) { }
                return true;
            } else {
                // feedback: not enough credits
                try {
                    if (scene && scene.tweens && langStartText) {
                        scene.tweens.add({ targets: langStartText, x: langStartText.x - 6, duration: 80, yoyo: true, repeat: 1 });
                    }
                } catch (e) { }
                return false;
            }
        }

        // Tile sheet mapping (copy from index.html TAIL_SHEET_MAP)
        const tailCols = 4, tailRows = 4;
        let tailCellW = 0, tailCellH = 0;
        // Sprite sheet constants (from index.html)
        const SHEET_COLS = 4, SHEET_ROWS = 4;
        let spriteCellW = 0, spriteCellH = 0;
        let spriteSheetPad = 2;
        const SPRITE_SHEET_MAP = {
            // row 0
            dynamite: { r: 0, c: 0 },
            heart: { r: 0, c: 1 },
            block: { r: 0, c: 2 },
            player: { r: 0, c: 3 },
            // row 1
            dynamite2: { r: 1, c: 0 },
            door: { r: 1, c: 1 },
            dynamon: { r: 1, c: 2 },
            shards: { r: 1, c: 3 },
            // row 2
            key: { r: 2, c: 0 },
            sand: { r: 2, c: 1 },
            ghost: { r: 2, c: 2 },
            doblon: { r: 2, c: 3 },
            // row 3
            wall: { r: 3, c: 0 },
            mine_tile: { r: 3, c: 1 },
            hole: { r: 3, c: 2 },
            explosion: { r: 3, c: 3 }
        };
        // Helper: apply crop from sprite sheet to an Image GameObject (global)
        function applySpriteCrop(scene, imgObj, keyName) {
            if (!imgObj || !SPRITE_SHEET_MAP[keyName]) return false;
            if (!spriteCellW || !spriteCellH) return false;
            const m = SPRITE_SHEET_MAP[keyName];
            const sx = Math.round(m.c * spriteCellW + spriteSheetPad);
            const sy = Math.round(m.r * spriteCellH + spriteSheetPad);
            const sw = Math.max(4, Math.round(spriteCellW - spriteSheetPad * 2));
            const sh = Math.max(4, Math.round(spriteCellH - spriteSheetPad * 2));
            try { imgObj.setCrop(sx, sy, sw, sh); } catch (e) { return false; }
            return true;
        }
        const TAIL_SHEET_MAP = {
            // row 0: wall variants
            wall1: { r: 0, c: 0 },
            wall2: { r: 0, c: 1 },
            wall3: { r: 0, c: 2 },
            wall4: { r: 0, c: 3 },
            // row 1: hole + sand variants
            hole: { r: 1, c: 0 },
            sand1: { r: 1, c: 1 },
            sand2: { r: 1, c: 2 },
            sand3: { r: 1, c: 3 },
            // row 2
            sand4: { r: 2, c: 0 },
            sand5: { r: 2, c: 1 },
            sandPile: { r: 2, c: 2 },
            sand6: { r: 2, c: 3 },
            // row 3
            sand7: { r: 3, c: 0 },
            sand8: { r: 3, c: 1 },
            sand9: { r: 3, c: 2 },
            sand10: { r: 3, c: 3 }
        };

        // Load a level JS (data/level/<name>.js) and draw it when ready
        function loadLevelByName(scene, name) {
            const id = 'level-script';
            const old = document.getElementById(id);
            if (old) old.remove();
            const script = document.createElement('script');
            script.id = id;
            script.src = 'data/level/' + name + '.js';
            script.onload = () => {
                if (window.LEVEL_MAP) {
                    // compute tail cell sizes from loaded texture
                    const tex = scene.textures.get('tileSheet');
                    if (tex && tex.source && tex.source[0]) {
                        const img = tex.source[0].image || tex.source[0].data;
                        tailCellW = img.width / tailCols;
                        tailCellH = img.height / tailRows;
                    }
                    drawLevel(scene, window.LEVEL_MAP);
                }
            };
            script.onerror = () => console.warn('Failed to load level', name);
            document.head.appendChild(script);
        }

        // Draw level map using tileSheet and TAIL_SHEET_MAP
        function drawLevel(scene, levelMap, _attempt = 0) {
            if (!levelMap || !levelMap.map) return;
            // If tile sheet cell sizes are not yet known and levelMap doesn't specify tileSize,
            // try to compute them from the loaded texture. If texture not yet available,
            // retry shortly (up to a few attempts) to avoid drawing with incorrect sizes.
            if ((!tailCellW || !tailCellH) && !levelMap.tileSize) {
                try {
                    const tex = scene.textures.get('tileSheet');
                    if (tex && tex.source && tex.source[0]) {
                        const img = tex.source[0].image || tex.source[0].data;
                        if (img && img.width && img.height) {
                            tailCellW = img.width / tailCols;
                            tailCellH = img.height / tailRows;
                        }
                    }
                } catch (e) { /* ignore */ }
                if ((!tailCellW || !tailCellH) && _attempt < 6) {
                    // schedule a retry after a short delay
                    try {
                        scene.time.delayedCall(80, () => drawLevel(scene, levelMap, _attempt + 1));
                        return;
                    } catch (e) { /* if no timer available, fall through */ }
                }
            }

            // remove existing floor container if any
            if (scene.floorContainer) {
                try { scene.floorContainer.destroy(true); } catch (e) { /* ignore */ }
            }
            const cols = levelMap.cols || (levelMap.map && levelMap.map[0] ? levelMap.map[0].length : 0);
            const rows = levelMap.rows || (levelMap.map ? levelMap.map.length : 0);
            if (!cols || !rows) return;

            // choose tile size: optional tileSize in levelMap or based on tile sheet cell
            let tileSize = levelMap.tileSize || Math.max(8, Math.round(Math.min(tailCellW || 32, tailCellH || 32)));
            // Clamp tileSize so tiles fit inside the scene and do not overlap
            const maxTileW = Math.max(4, Math.floor(scene.scale.width / cols));
            const maxTileH = Math.max(4, Math.floor(scene.scale.height / rows));
            tileSize = Math.min(tileSize, maxTileW, maxTileH);

            const originX = Math.round((scene.scale.width - cols * tileSize) / 2);
            const originY = Math.round((scene.scale.height - rows * tileSize) / 2);

            const container = scene.add.container(0, 0);
            scene.floorContainer = container;

            for (let r = 0; r < rows; r++) {
                const row = levelMap.map[r] || [];
                for (let c = 0; c < cols; c++) {
                    const key = (row && row[c]) ? row[c] : null;
                    const mapEntry = TAIL_SHEET_MAP[key];
                    const x = Math.round(originX + c * tileSize + tileSize / 2);
                    const y = Math.round(originY + r * tileSize + tileSize / 2);
                    if (!mapEntry) {
                        // draw placeholder rect for empty/unknown tiles
                        const rect = scene.add.rectangle(x, y, tileSize, tileSize, 0xbfa57a).setOrigin(0.5);
                        container.add(rect);
                        continue;
                    }
                    // compute source rect
                    const sx = Math.round(mapEntry.c * (tailCellW || tileSize));
                    const sy = Math.round(mapEntry.r * (tailCellH || tileSize));
                    const sw = Math.max(4, Math.round(tailCellW || tileSize));
                    const sh = Math.max(4, Math.round(tailCellH || tileSize));
                    const img = scene.add.image(x, y, 'tileSheet').setOrigin(0.5);
                    // crop the source to the tile area (if available)
                    try { img.setCrop(sx, sy, sw, sh); } catch (e) { /* ignore crop errors */ }
                    img.setDisplaySize(tileSize, tileSize);
                    container.add(img);
                }
            }
            // send container to back
            try { container.setDepth(-10); } catch (e) { /* ignore */ }
        }

        // Language helper functions
        function changeLang(delta, scene) {
            currentLangIndex = (currentLangIndex + delta + LANGS.length) % LANGS.length;
            localStorage.setItem('bh_lang', LANGS[currentLangIndex]);
            updateFlagCrop(scene);
            loadDictionary(LANGS[currentLangIndex]);
        }

        function updateFlagCrop(scene) {
            if (!langFlagImage) return;
            const tex = scene.textures.get('flags');
            if (!tex || !tex.source || !tex.source[0]) return;
            const img = tex.source[0].image || tex.source[0].data;
            const totalW = img.width;
            const totalH = img.height;
            const sliceW = Math.floor(totalW / LANGS.length);
            const sx = sliceW * currentLangIndex;
            // Phaser Image#setCrop expects numbers
            langFlagImage.setCrop(sx, 0, sliceW, totalH);
            // adjust display size to keep flags visible
            langFlagImage.setDisplaySize(96, Math.round(96 * (totalH / sliceW)));
        }

        function loadDictionary(lang) {
            // 1) If the user provided an in-memory dictionary map (window.BH_DICS), use it.
            if (window.BH_DICS && window.BH_DICS[lang]) {
                try {
                    const raw = window.BH_DICS[lang];
                    const normalized = adaptDictionary(raw || {});
                    window.DICT = normalized;
                    const missing = findMissingKeys(normalized);
                    if (missing.length && lang !== 'en') {
                        loadReferenceDict('en').then(ref => { try { const refNorm = adaptDictionary(ref || {}); fillMissingFromReference(window.DICT, refNorm); } catch (e) { }; applyTranslations(); }).catch(() => { applyTranslations(); });
                    } else {
                        applyTranslations();
                    }
                } catch (e) { console.warn('Error processing in-memory dictionary for', lang, e); }
                return;
            }

            // 2) Try fetching a JSON file (data/dic/<lang>.json) — useful if static .js is blocked
            const jsonUrl = 'data/dic/' + lang + '.json';
            fetch(jsonUrl, { cache: 'no-cache' }).then(r => {
                if (!r.ok) throw new Error('json not found');
                return r.json();
            }).then(json => {
                try {
                    const normalized = adaptDictionary(json || {});
                    window.DICT = normalized;
                    const missing = findMissingKeys(normalized);
                    if (missing.length && lang !== 'en') {
                        loadReferenceDict('en').then(ref => { try { const refNorm = adaptDictionary(ref || {}); fillMissingFromReference(window.DICT, refNorm); } catch (e) { }; applyTranslations(); }).catch(() => { applyTranslations(); });
                    } else {
                        applyTranslations();
                    }
                } catch (e) { console.warn('Error processing json dictionary for', lang, e); applyTranslations(); }
            }).catch(() => {
                // 3) Fallback: try loading the legacy script file `data/dic/<lang>.js` (kept for compatibility)
                const id = 'dict-script';
                const old = document.getElementById(id);
                if (old) old.remove();
                const script = document.createElement('script');
                script.id = id;
                script.src = 'data/dic/' + lang + '.js';
                script.onload = () => {
                    try {
                        const raw = window.DICT || {};
                        const normalized = adaptDictionary(raw);
                        window.DICT = normalized;
                        const missing = findMissingKeys(normalized);
                        if (missing.length && lang !== 'en') {
                            loadReferenceDict('en').then(ref => { try { const refNorm = adaptDictionary(ref || {}); fillMissingFromReference(window.DICT, refNorm); } catch (e) { }; applyTranslations(); }).catch(() => { applyTranslations(); });
                        } else {
                            applyTranslations();
                        }
                    } catch (e) {
                        console.warn('Error processing dictionary for', lang, e);
                        if (window.DICT) applyTranslations();
                    }
                };
                script.onerror = () => console.warn('Failed to load dictionary for', lang);
                document.head.appendChild(script);
            });
        }

        // Helper: load reference dictionary via script tag and return a Promise resolving to its window.DICT
        function loadReferenceDict(refLang) {
            return new Promise((resolve, reject) => {
                // First check for in-memory registration
                if (window.BH_DICS && window.BH_DICS[refLang]) {
                    resolve(window.BH_DICS[refLang]);
                    return;
                }
                // Try fetching JSON first
                const jsonUrl = 'data/dic/' + refLang + '.json';
                fetch(jsonUrl, { cache: 'no-cache' }).then(r => {
                    if (!r.ok) throw new Error('json not found');
                    return r.json();
                }).then(json => resolve(json)).catch(() => {
                    const id = 'dict-ref-script';
                    const old = document.getElementById(id);
                    if (old) old.remove();
                    const script = document.createElement('script');
                    script.id = id;
                    script.src = 'data/dic/' + refLang + '.js';
                    script.onload = () => { try { resolve(window.DICT || {}); } catch (e) { resolve({}); } };
                    script.onerror = () => { reject(new Error('ref dict load failed')); };
                    document.head.appendChild(script);
                });
            });
        }

        // Canonical keys and common aliases mapping. The adapter will search aliases in the raw dict
        // and populate canonical keys used by the game.
        const DICT_ALIASES = {
            title: ['title', 'game_title', 'attract_title'],
            instructions: ['instructions', 'howto', 'attract_instructions'],
            insert_coin: ['insert_coin', 'insert_coin_btn', 'attractmode.staticcredits', 'coin_text'],
            credits_word: ['credits_word', 'credits_label', 'credits'],
            highscores: ['highscores', 'high_scores', 'top_ten', 'highscore_title'],
            p1_label: ['p1_label', 'player1_label', 'player_one'],
            p2_label: ['p2_label', 'player2_label', 'player_two'],
            lives_label: ['lives_label', 'lives', 'life_label'],
            level: ['level', 'level_label', 'lvl'],
            select_title: ['select_title', 'selectscreen_title'],
            select_hint: ['select_hint', 'selectscreen_hint'],
            one_player_label: ['one_player_label', 'one_player', '1player_label'],
            two_players_label: ['two_players_label', 'two_players', '2player_label'],
            cancel: ['cancel', 'back', 'indietro'],
            game_over: ['game_over', 'gameover', 'end_title'],
            retry: ['retry', 'retry_label', 'ripeti']
        };

        // Utility: get nested value by path 'a.b.c'
        function getNested(obj, path) {
            if (!obj || !path) return undefined;
            const parts = path.split('.');
            let cur = obj;
            for (let p of parts) {
                if (cur == null) return undefined;
                cur = cur[p];
            }
            return cur;
        }

        // Find missing canonical keys (returns array of keys where normalized[key] is undefined/null)
        function findMissingKeys(norm) {
            const miss = [];
            for (const k of Object.keys(DICT_ALIASES)) {
                if (norm[k] === undefined || norm[k] === null) miss.push(k);
            }
            return miss;
        }

        // Fill missing keys in target from reference normalized dict
        function fillMissingFromReference(target, reference) {
            for (const k of Object.keys(DICT_ALIASES)) {
                if ((target[k] === undefined || target[k] === null) && reference[k] !== undefined) {
                    target[k] = reference[k];
                }
            }
        }

        // Adapt a raw dictionary (possibly with variant key names) to canonical keys
        function adaptDictionary(raw) {
            const out = {};
            // allow raw to be null
            const src = raw || {};
            for (const canon of Object.keys(DICT_ALIASES)) {
                const aliases = DICT_ALIASES[canon] || [canon];
                let found = undefined;
                for (const a of aliases) {
                    // support nested paths in alias
                    const val = getNested(src, a);
                    if (val !== undefined && val !== null) { found = val; break; }
                }
                // if not found, but raw had the canonical key directly, use it
                if ((found === undefined || found === null) && (src[canon] !== undefined)) found = src[canon];
                out[canon] = found;
            }
            // also copy any other keys from raw that are not aliases (keep extras)
            for (const k of Object.keys(src)) {
                if (!out.hasOwnProperty(k)) out[k] = src[k];
            }
            return out;
        }

        // Public API: register an in-memory dictionary map so the game can use it without file access.
        // Example: registerDictionary('it', { title: '...', insert_coin: '...' })
        function registerDictionary(lang, dict) {
            if (!window.BH_DICS) window.BH_DICS = {};
            window.BH_DICS[lang] = dict || {};
            // if this is the currently selected language, apply immediately
            const current = LANGS[currentLangIndex];
            if (current === lang) {
                try { loadDictionary(lang); } catch (e) { console.warn('registerDictionary load failed', e); }
            }
        }
        // expose helper globally
        try { window.registerDictionary = registerDictionary; } catch (e) { }

