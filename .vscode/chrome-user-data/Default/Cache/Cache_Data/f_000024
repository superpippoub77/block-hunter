        function collectTarget(playerHit, target) {
            // award points to the player who collected the target
            if (playerHit === player) {
                score1 += 100 * level;
                if (scoreText1) scoreText1.setText('P1: ' + score1);
            } else if (playerHit === player2) {
                score2 += 100 * level;
                if (scoreText2) scoreText2.setText('P2: ' + score2);
            }

            // Effetto particelle
            createParticleExplosion(this, target.x, target.y, 0xffff00);

            spawnTarget(this);

            // Level up based on combined score every 500 points
            const combined = (score1 || 0) + (score2 || 0);
            const newThreshold = Math.floor(combined / 500);
            if (newThreshold > _levelThreshold) {
                level += (newThreshold - _levelThreshold);
                _levelThreshold = newThreshold;
                if (levelText) levelText.setText('LEVEL: ' + level);
            }
        }

        function hitBlock(playerHit, block) {
            if (block.getData('spawning')) return; // Non collidere durante spawn

            // decrement correct player's lives
            if (playerHit === player) {
                lives1--;
                if (livesText1) livesText1.setText('LIVES: ' + lives1);
            } else if (playerHit === player2) {
                lives2--;
                if (livesText2) livesText2.setText('LIVES: ' + lives2);
            }

            // Effetto particelle
            createParticleExplosion(this, playerHit.x, playerHit.y, 0xff0000);

            block.destroy();
            // if a player's lives reached zero, hide/disable them and schedule respawn
            if (playerHit === player && lives1 <= 0) {
                try { if (player.body) player.body.enable = false; if (player.setVisible) player.setVisible(false); } catch (e) { }
                scheduleRespawn('p1', this);
            }
            if (playerHit === player2 && lives2 <= 0) {
                try { if (player2.body) player2.body.enable = false; if (player2.setVisible) player2.setVisible(false); } catch (e) { }
                scheduleRespawn('p2', this);
            }

            // if both players have no lives left, trigger game over
            if ((lives1 <= 0) && (lives2 <= 0)) {
                gameOver(this);
            }
        }

        function destroyBlock(bullet, block) {
            // award points to shooter
            const owner = bullet && bullet.getData ? bullet.getData('owner') : null;
            if (owner === 'p1') {
                score1 += 10;
                if (scoreText1) scoreText1.setText('P1: ' + score1);
            } else if (owner === 'p2') {
                score2 += 10;
                if (scoreText2) scoreText2.setText('P2: ' + score2);
            } else {
                // fallback to player1
                score1 += 10;
                if (scoreText1) scoreText1.setText('P1: ' + score1);
            }

            // Effetto particelle
            createParticleExplosion(this, block.x, block.y, 0xff00ff);

            if (bullet && bullet.destroy) bullet.destroy();
            if (block && block.destroy) block.destroy();

            // check level up from combined score
            const combined = (score1 || 0) + (score2 || 0);
            const newThreshold = Math.floor(combined / 500);
            if (newThreshold > _levelThreshold) {
                level += (newThreshold - _levelThreshold);
                _levelThreshold = newThreshold;
                if (levelText) levelText.setText('LEVEL: ' + level);
            }
        }

        function createParticleExplosion(scene, x, y, color) {
            for (let i = 0; i < 8; i++) {
                // prefer a small shard sprite when available
                let particle = null;
                try {
                    particle = scene.physics.add.image(x, y, 'spriteSheet');
                    if (applySpriteCrop(scene, particle, 'shards')) particle.setDisplaySize(6, 6);
                    else {
                        particle.destroy();
                        particle = null;
                    }
                } catch (e) { particle = null; }

                if (!particle) {
                    particle = scene.add.rectangle(x, y, 4, 4, color);
                    scene.physics.add.existing(particle);
                }

                const angle = (Math.PI * 2 * i) / 8;
                const speed = 200;
                try { particle.body.setVelocity(Math.cos(angle) * speed, Math.sin(angle) * speed); } catch (e) { }

                scene.tweens.add({ targets: particle, alpha: 0, duration: 500, onComplete: () => particle.destroy() });
            }
        }

        // Schedule a respawn for a specific player id ('p1' or 'p2') after a short delay.
        // If the other player is still alive, respawn will grant 1 life and restore the sprite.
        function scheduleRespawn(playerId, scene) {
            const delayMs = 2000;
            // visual feedback (flash)
            try {
                const centerX = scene.scale.width / 2 || 400;
                const centerY = scene.scale.height / 2 || 300;
                const info = scene.add.text(centerX, centerY + (playerId === 'p1' ? -40 : 40), (playerId === 'p1' ? 'P1 DEAD' : 'P2 DEAD') + '\nRESPAWN...', { fontSize: '12px', fontFamily: GAME_FONT, fill: '#ff8888', align: 'center' }).setOrigin(0.5);
                scene.tweens.add({ targets: info, alpha: { from: 1, to: 0 }, duration: delayMs, onComplete: () => info.destroy() });
            } catch (e) { }

            scene.time.delayedCall(delayMs, () => {
                // if both players dead, let gameOver handle it
                if ((lives1 <= 0) && (lives2 <= 0)) return;

                if (playerId === 'p1') {
                    // respawn only if player object exists or was not present
                    try {
                        if (!player) {
                            try {
                                player = scene.physics.add.image(300, 550, 'spriteSheet');
                                if (applySpriteCrop(scene, player, 'player')) player.setDisplaySize(20, 20);
                                else player.setTint(0x00ff00);
                            } catch (e) {
                                player = scene.add.rectangle(300, 550, 20, 20, 0x00ff00);
                                scene.physics.add.existing(player);
                            }
                        }
                        // ensure body exists and enable it
                        if (player.body) player.body.enable = true;
                        player.setVisible(true);
                        // give one life on respawn
                        lives1 = Math.max(1, lives1);
                        if (livesText1) livesText1.setText('LIVES: ' + lives1);
                        // place near bottom center
                        player.x = 300; player.y = 550;
                        // re-add overlaps
                        try { scene.physics.add.overlap(player, target, collectTarget, null, scene); scene.physics.add.overlap(player, blocks, hitBlock, null, scene); } catch (e) { }
                    } catch (e) { console.warn('respawn p1 error', e); }
                }
                if (playerId === 'p2') {
                    try {
                        if (!player2) {
                            try {
                                player2 = scene.physics.add.image(500, 550, 'spriteSheet');
                                if (applySpriteCrop(scene, player2, 'player')) player2.setDisplaySize(20, 20);
                                else player2.setTint(0x0000ff);
                            } catch (e) {
                                player2 = scene.add.rectangle(500, 550, 20, 20, 0x0000ff);
                                scene.physics.add.existing(player2);
                            }
                        }
                        if (player2.body) player2.body.enable = true;
                        player2.setVisible(true);
                        lives2 = Math.max(1, lives2);
                        if (livesText2) livesText2.setText('LIVES: ' + lives2);
                        player2.x = 500; player2.y = 550;
                        try { scene.physics.add.overlap(player2, target, collectTarget, null, scene); scene.physics.add.overlap(player2, blocks, hitBlock, null, scene); } catch (e) { }
                    } catch (e) { console.warn('respawn p2 error', e); }
                }
            });
        }

        // shoot from a shooter (player or player2). If shooter omitted, default to player
        function shoot(scene, shooter) {
            const src = shooter || player;
            if (!src) return;
            // color bullets differently based on shooter
            // prefer small sprite shard for bullets; fallback to rectangle
            let bullet = null;
            try {
                bullet = scene.physics.add.image(src.x, src.y - 15, 'spriteSheet');
                if (applySpriteCrop(scene, bullet, 'shards')) bullet.setDisplaySize(6, 10);
                else { bullet.destroy(); bullet = null; }
            } catch (e) { bullet = null; }
            if (!bullet) {
                const color = (src === player2) ? 0x0000ff : 0x00ff00;
                bullet = scene.add.rectangle(src.x, src.y - 15, 4, 10, color);
                scene.physics.add.existing(bullet);
            }
            try { if (bullet.body) bullet.body.setVelocity(0, -400); } catch (e) { }
            // mark owner for scoring
            try { bullet.setData('owner', (src === player2) ? 'p2' : 'p1'); } catch (e) { }
            bullets.add(bullet);
        }

        function gameOver(scene) {
            scene.physics.pause();

            // ask for names and save highscores for both players (if applicable)
            try { submitScoresAndSave(scene); } catch (e) { console.warn('submit scores failed', e); }

            const overlay = scene.add.rectangle(400, 300, 800, 600, 0x000000, 0.8);

            const goText = (window.DICT && window.DICT.game_over) || 'GAME OVER';
            const gameOverText = scene.add.text(400, 200, goText, {
                fontSize: '48px',
                fontFamily: GAME_FONT,
                fill: '#ff0000',
                stroke: '#ffff00',
                strokeThickness: 3
            }).setOrigin(0.5);
            const p1label = (window.DICT && window.DICT.p1_label) || 'P1';
            const p2label = (window.DICT && window.DICT.p2_label) || 'P2';
            const finalScore = scene.add.text(400, 260, `${p1label}: ${score1}   ${p2label}: ${score2}`, {
                fontSize: '16px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setOrigin(0.5);
            const levelLabel = (window.DICT && (window.DICT.level || window.DICT.level_label)) || 'LIVELLO RAGGIUNTO';
            const finalLevel = scene.add.text(400, 300, levelLabel + ': ' + level, {
                fontSize: '16px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setOrigin(0.5);

            const restartButton = scene.add.rectangle(400, 420, 250, 60, 0xff00ff);
            const retryLabel = (window.DICT && window.DICT.retry) || ((window.DICT && window.DICT.retry_label) || 'RIPROVA');
            const restartText = scene.add.text(400, 420, retryLabel, {
                fontSize: '20px',
                fontFamily: GAME_FONT,
                fill: '#000000'
            }).setOrigin(0.5);

            restartButton.setInteractive({ useHandCursor: true });
            restartButton.on('pointerdown', () => {
                // reset per-player stats
                score1 = 0; score2 = 0;
                lives1 = 3; lives2 = 3;
                _levelThreshold = 0;
                level = 1;
                gameStarted = true;
                // ensure players exist again for restart path
                try { player = null; player2 = null; } catch (e) { }
                scene.scene.restart();
            });
        }

        function update() {
            if (!gameStarted) return;

            // Movimento player (player 1 - cursors)
            if (player) {
                if (cursors.left.isDown) {
                    player.x -= 5;
                } else if (cursors.right.isDown) {
                    player.x += 5;
                }

                if (cursors.up.isDown) {
                    player.y -= 5;
                } else if (cursors.down.isDown) {
                    player.y += 5;
                }

                // Limiti player 1
                player.x = Phaser.Math.Clamp(player.x, 10, 790);
                player.y = Phaser.Math.Clamp(player.y, 10, 590);

                // Sparo player 1 (SPACE)
                if (Phaser.Input.Keyboard.JustDown(spaceKey)) {
                    shoot(this, player);
                }
            }

            // Player 2 (WASD + F to shoot)
            if (player2 && wasdKeys) {
                try {
                    if (wasdKeys.left && wasdKeys.left.isDown) player2.x -= 5;
                    else if (wasdKeys.right && wasdKeys.right.isDown) player2.x += 5;

                    if (wasdKeys.up && wasdKeys.up.isDown) player2.y -= 5;
                    else if (wasdKeys.down && wasdKeys.down.isDown) player2.y += 5;

                    // Limits for player 2
                    player2.x = Phaser.Math.Clamp(player2.x, 10, 790);
                    player2.y = Phaser.Math.Clamp(player2.y, 10, 590);

                    const p2ShootKey = wasdKeys.shoot || wasdKeys.F || wasdKeys.f;
                    if (p2ShootKey && Phaser.Input.Keyboard.JustDown(p2ShootKey)) {
                        shoot(this, player2);
                    }
                } catch (e) {
                    // swallow any input mapping errors
                }
            }

            // Target lifetime
            targetLifetime++;
            if (targetLifetime > 180) { // 3 secondi a 60fps
                spawnTarget(this);
            }

            // Spawn blocchi
            const spawnRate = Math.max(30 - level * 2, 10);
            blockSpawnTimer++;
            if (blockSpawnTimer >= spawnRate) {
                spawnBlock(this);
                blockSpawnTimer = 0;
            }

            // Update blocchi - gestione collisioni e stacking
            blocks.children.entries.forEach((block, index) => {
                if (block.getData('landed')) return;

                // Controlla collisione con altri blocchi
                blocks.children.entries.forEach((otherBlock, otherIndex) => {
                    if (index === otherIndex || !otherBlock.getData('landed')) return;

                    const bounds1 = block.getBounds();
                    const bounds2 = otherBlock.getBounds();

                    // Predici la posizione nel prossimo frame
                    const nextBounds = new Phaser.Geom.Rectangle(
                        bounds1.x + block.body.velocity.x / 60,
                        bounds1.y + block.body.velocity.y / 60,
                        bounds1.width,
                        bounds1.height
                    );

                    if (Phaser.Geom.Intersects.RectangleToRectangle(nextBounds, bounds2)) {
                        // Ferma il blocco
                        block.setData('landed', true);
                        block.body.setVelocity(0, 0);

                        // Posiziona correttamente
                        if (block.body.velocity.y > 0) {
                            block.y = otherBlock.y - 20;
                        } else if (block.body.velocity.y < 0) {
                            block.y = otherBlock.y + 20;
                        } else if (block.body.velocity.x > 0) {
                            block.x = otherBlock.x - 20;
                        } else if (block.body.velocity.x < 0) {
                            block.x = otherBlock.x + 20;
                        }
                    }
                });

                // Controlla bordi
                if (block.y >= 590 || block.y <= 10 || block.x <= 10 || block.x >= 790) {
                    block.setData('landed', true);
                    block.body.setVelocity(0, 0);
                    block.y = Phaser.Math.Clamp(block.y, 10, 590);
                    block.x = Phaser.Math.Clamp(block.x, 10, 790);
                }
            });

            // Rimuovi proiettili fuori schermo
            bullets.children.entries.forEach(bullet => {
                if (bullet.y < -20) {
                    bullet.destroy();
                }
            });

            // Rimuovi blocchi molto fuori schermo
            blocks.children.entries.forEach(block => {
                if (block.x < -100 || block.x > 900 || block.y < -100 || block.y > 700) {
                    if (!block.getData('landed')) {
                        block.destroy();
                    }
                }
            });
        }

        // Global keyboard handling for coin insert and quick player select while in attract
        // Attach once
        if (!window._bh_phaser_keys_initialized) {
            window._bh_phaser_keys_initialized = true;
            window.addEventListener('keydown', (e) => {
                // when attract visible (game not started)
                if (gameStarted) return;
                // Insert coin with '5'
                if (e.key === '5') {
                    e.preventDefault();
                    insertCoin(1, null);
                    return;
                }
                // Quick player start with '1' or '2'
                if (e.key === '1' || e.key === '2') {
                    e.preventDefault();
                    const n = parseInt(e.key, 10);
                    // try start using the active scene if possible
                    const scenes = (window.game && window.game.scene) ? window.game.scene.getScenes(true) : [];
                    const active = scenes && scenes.length ? scenes[0] : null;
                    const ok = tryStartWithPlayers(n, active);
                    if (!ok) {
                        // show required credit hint (simple console for now)
                        console.warn('Not enough credits for', n, 'players. Credits:', credits);
                    }
                    return;
                }
                // Enter behavior: open level/player select overlay (like index.html)
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const scenes = (window.game && window.game.scene) ? window.game.scene.getScenes(true) : [];
                    const active = scenes && scenes.length ? scenes[0] : null;
                    // open selection overlay (it will show credit status and buttons)
                    showLevelPlayerSelect(active, null);
                    return;
                }
            });
        }
    </script>
