<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOCK HUNTER</title>
    <script src="https://cdn.jsdelivr.net/npm/phaser@3.70.0/dist/phaser.min.js"></script>
    <!-- Load Google Font via stylesheet link (more reliable than @import for timing) -->
    <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> -->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet"> -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }



        body {
            background: #0a0e27;
            font-family: 'Press Start 2P', monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        #game-container {
            /* make the game container cover the whole viewport so Phaser will scale the internal 800x600 canvas to fullscreen */
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            border: 0;
            /* remove the boxed riquadro; change to 4px if you want a border on fullscreen */
            box-shadow: none;
            border-radius: 0;
        }

        /* Local font: place your font files in assets/fonts/
           Example filenames expected by the project:
             - assets/fonts/PressStart2P.woff2
             - assets/fonts/PressStart2P.woff
           The @font-face below will prefer the local files and fall back to
           Google Fonts if the local files are missing. This avoids network
           dependency and adblock issues during development. */
        @font-face {
            font-family: 'Press Start 2P';
            /* prefer modern compressed formats first for performance */
            src: local('Press Start 2P'),
                url('assets/fonts/PressStart2P.woff2') format('woff2'),
                url('assets/fonts/PressStart2P.woff') format('woff'),
                url('assets/fonts/PressStart2P.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
    </style>
</head>

<body>
    <div id="game-container"></div>

    <script>
        // Show a level/player select overlay similar to index.html
        function showLevelPlayerSelect(scene, preselect) {
            if (!scene) return;
            if (selectContainer) {
                selectContainer.setVisible(true);
                return;
            }
            const sw = scene.scale.width || 800;
            const sh = scene.scale.height || 600;
            selectContainer = scene.add.container(0, 0).setDepth(2000);
            const bg = scene.add.rectangle(sw / 2, sh / 2, sw, sh, 0x000000, 0.6).setOrigin(0.5).setInteractive();
            selectContainer.add(bg);

            const title = scene.add.text(sw / 2, 120, (window.DICT && window.DICT.select_title) || 'SELEZIONA', { fontSize: '32px', fontFamily: GAME_FONT, fill: '#ffffff' }).setOrigin(0.5);
            selectContainer.add(title);

            selectCreditsText = scene.add.text(sw / 2, 180, (credits && credits > 0) ? `CREDITI: ${credits}` : ((window.DICT && window.DICT.insert_coin) || 'INSERISCI MONETA'), { fontSize: '18px', fontFamily: GAME_FONT, fill: '#00ffff' }).setOrigin(0.5);
            selectContainer.add(selectCreditsText);

            selectHintText = scene.add.text(sw / 2, 220, (window.DICT && window.DICT.select_hint) || 'Scegli numero giocatori:', { fontSize: '16px', fontFamily: GAME_FONT, fill: '#00ffff' }).setOrigin(0.5);
            selectContainer.add(selectHintText);

            // Buttons for 1 and 2 players
            const btnW = 220, btnH = 64;
            const btn1 = scene.add.rectangle(sw / 2 - 140, 320, btnW, btnH, 0xff00ff).setOrigin(0.5).setInteractive({ useHandCursor: true });
            selectContainer.add(btn1);
            selectBtn1Text = scene.add.text(sw / 2 - 140, 320, (window.DICT && window.DICT.one_player_label) || `1 PLAYER\n(${CREDITS_PER_PLAYER} crediti)`, { fontSize: '14px', fontFamily: GAME_FONT, fill: '#000' }).setOrigin(0.5);
            selectContainer.add(selectBtn1Text);
            const btn2 = scene.add.rectangle(sw / 2 + 140, 320, btnW, btnH, 0xff00ff).setOrigin(0.5).setInteractive({ useHandCursor: true });
            selectContainer.add(btn2);
            selectBtn2Text = scene.add.text(sw / 2 + 140, 320, (window.DICT && window.DICT.two_players_label) || `2 PLAYERS\n(${CREDITS_PER_PLAYER * 2} crediti)`, { fontSize: '14px', fontFamily: GAME_FONT, fill: '#000' }).setOrigin(0.5);
            selectContainer.add(selectBtn2Text);

            selectCancelText = scene.add.text(sw / 2, 420, (window.DICT && window.DICT.cancel) || 'INDIETRO', { fontSize: '14px', fontFamily: GAME_FONT, fill: '#00ffff' }).setOrigin(0.5).setInteractive({ useHandCursor: true });
            selectContainer.add(selectCancelText);

            btn1.on('pointerdown', () => { tryStartWithPlayers(1, scene); });
            btn2.on('pointerdown', () => { tryStartWithPlayers(2, scene); });
            selectCancelText.on('pointerdown', () => { try { selectContainer.destroy(true); selectContainer = null; } catch (e) { } });

            // keyboard shortcuts while overlay open
            const keyHandler = (ev) => {
                if (!selectContainer) { window.removeEventListener('keydown', keyHandler); return; }
                if (ev.key === '1') { ev.preventDefault(); tryStartWithPlayers(1, scene); }
                else if (ev.key === '2') { ev.preventDefault(); tryStartWithPlayers(2, scene); }
                else if (ev.key === 'Escape') { ev.preventDefault(); try { selectContainer.destroy(true); selectContainer = null; } catch (e) { } }
            };
            window.addEventListener('keydown', keyHandler);
        }
        // Configurazione Phaser
        const config = {
            type: Phaser.AUTO,
            parent: 'game-container',
            // use Phaser Scale Manager so the internal resolution remains 800x600
            // but the canvas is scaled to fill the container (which now is full viewport)
            scale: {
                mode: Phaser.Scale.FIT,
                autoCenter: Phaser.Scale.CENTER_BOTH,
                width: 800,
                height: 600
            },
            physics: {
                default: 'arcade',
                arcade: {
                    gravity: { y: 0 },
                    debug: false
                }
            },
            scene: {
                preload: preload,
                create: create,
                update: update
            },
            backgroundColor: '#0a0e27',
        };

        // create the Phaser.Game only after the font is available so canvas texts render correctly
        function launchGame() {
            // use global var if other code expects `game`
            window.game = new Phaser.Game(config);
            // After a short delay, force updated fontFamily on any created Text objects.
            // This helps when the font finishes loading slightly after the initial draw.
            setTimeout(() => {
                try {
                    if (!window.game || !window.game.scene) return;
                    const activeScenes = window.game.scene.getScenes(true);
                    activeScenes.forEach(s => {
                        if (!s || !s.children) return;
                        s.children.list.forEach(child => {
                            // Phaser Text objects have type 'Text'
                            if (child && child.type === 'Text') {
                                try {
                                    child.setStyle({ fontFamily: GAME_FONT });
                                    // trigger redraw
                                    child.setText(child.text);
                                } catch (e) { /* ignore per-child errors */ }
                            }
                        });
                    });
                } catch (e) {
                    console.warn('Error applying GAME_FONT to text objects', e);
                }
            }, 300);
        }

        // Use a constant for the font family name (no extra quotes) and reuse it
        // across all Phaser Text styles.
        const GAME_FONT = 'Press Start 2P';

        // Helper: try to detect which font source is usable and log it for debugging.
        // This uses FontFace loading (for local files) and a width-measurement heuristic
        // to decide if the 'Press Start 2P' family is active.
        function detectAndLogFontSource() {
            return new Promise(async (resolve) => {
                const testString = 'mmmmmmmmmlllliiiWWW';
                function measureWidth(fontFamily) {
                    try {
                        const span = document.createElement('span');
                        span.style.position = 'absolute';
                        span.style.left = '-9999px';
                        span.style.top = '-9999px';
                        span.style.fontSize = '32px';
                        span.style.fontFamily = fontFamily;
                        span.textContent = testString;
                        document.body.appendChild(span);
                        const w = span.getBoundingClientRect().width;
                        document.body.removeChild(span);
                        return w;
                    } catch (e) { return null; }
                }

                const baseline = measureWidth('monospace');
                const ps2pNow = (document.fonts && document.fonts.check) ? document.fonts.check('16px "Press Start 2P"') : false;

                const localCandidates = [
                    { url: 'assets/fonts/PressStart2P.woff2', label: 'local-woff2' },
                    { url: 'assets/fonts/PressStart2P.woff', label: 'local-woff' },
                    { url: 'assets/fonts/PressStart2P.ttf', label: 'local-ttf' }
                ];

                const avail = [];
                if (window.FontFace) {
                    for (const c of localCandidates) {
                        try {
                            const ff = new FontFace('PS2P-detect-' + c.label, `url("${c.url}")`);
                            // eslint-disable-next-line no-await-in-loop
                            const loaded = await ff.load().catch(() => null);
                            if (loaded) {
                                try { document.fonts.add(loaded); } catch (e) { /* ignore */ }
                                avail.push({ ok: true, label: c.label, url: c.url });
                                break;
                            }
                        } catch (e) { /* ignore per-candidate errors */ }
                    }
                }

                const gfPresent = !!document.getElementById('bh-google-font-fallback');
                const ps2pWidth = measureWidth('"Press Start 2P", monospace');

                let decided = 'unknown';
                if (ps2pNow || (ps2pWidth && baseline && Math.abs(ps2pWidth - baseline) > 2)) {
                    if (avail.length) decided = avail[0].label;
                    else if (gfPresent) decided = 'google-fallback';
                    else decided = 'press-start-2p (unknown source, maybe local())';
                } else {
                    if (avail.length) decided = avail[0].label + ' (loaded but not applied yet)';
                    else if (gfPresent) decided = 'google-fallback (not yet applied)';
                    else decided = 'not-available';
                }

                console.info('[FONT-DETECT] baseline monospace width:', baseline, 'ps2p width:', ps2pWidth, 'font-family check:', ps2pNow);
                console.info('[FONT-DETECT] local candidates result:', avail);
                console.info('[FONT-DETECT] google fallback present:', gfPresent);
                console.info('[FONT-DETECT] decided source:', decided);
                resolve(decided);
            });
        }

        // Helper: safely set text on a Phaser Text object with optional retry when font/texture not ready.
        function safeSetTextWithRetry(obj, text, scene, maxRetries = 3, delay = 150) {
            if (!obj || typeof obj.setText !== 'function') return false;
            try {
                obj.setText(text);
                return true;
            } catch (e) {
                // schedule retry if possible
                try {
                    obj._setTextRetries = (obj._setTextRetries || 0) + 1;
                    if (scene && scene.time && obj._setTextRetries <= maxRetries) {
                        scene.time.delayedCall(delay, () => {
                            try {
                                obj.setText(text);
                            } catch (e2) {
                                // nothing — if retries fail we'll log once
                                console.warn('safeSetTextWithRetry: retry failed for', text, e2);
                            }
                        });
                    } else {
                        console.warn('safeSetTextWithRetry: cannot retry setText for', text, e);
                    }
                } catch (e2) { /* ignore scheduling errors */ }
                return false;
            }
        }

        // Use Font Loading API when available to ensure 'Press Start 2P' is ready
        // Diagnostic: fetch local font files and log HTTP status + headers to help debug network errors
        function fetchFontDiagnostics() {
            const candidates = [
                'assets/fonts/PressStart2P.woff2',
                'assets/fonts/PressStart2P.woff',
                'assets/fonts/PressStart2P.ttf'
            ];
            const results = [];
            return Promise.all(candidates.map(async (url) => {
                const out = { url };
                try {
                    // Try HEAD first to avoid downloading the file
                    const head = await fetch(url, { method: 'HEAD', cache: 'no-cache' });
                    out.status = head.status;
                    out.ok = head.ok;
                    out.headers = {
                        'content-type': head.headers.get('content-type'),
                        'content-length': head.headers.get('content-length')
                    };
                    // Some static servers may not support HEAD; if status is 405, try GET with range
                    if (head.status === 405) {
                        const rng = await fetch(url, { method: 'GET', headers: { Range: 'bytes=0-1' }, cache: 'no-cache' });
                        out.status = rng.status;
                        out.ok = rng.ok;
                        out.headers = {
                            'content-type': rng.headers.get('content-type'),
                            'content-length': rng.headers.get('content-length')
                        };
                    }
                } catch (e) {
                    // fallback: try a GET to capture network errors
                    try {
                        const get = await fetch(url, { method: 'GET', cache: 'no-cache' });
                        out.status = get.status;
                        out.ok = get.ok;
                        out.headers = {
                            'content-type': get.headers.get('content-type'),
                            'content-length': get.headers.get('content-length')
                        };
                    } catch (e2) {
                        out.error = (e2 && e2.message) ? e2.message : String(e2);
                    }
                }
                results.push(out);
                return out;
            })).then(() => results);
        }

        // Run diagnostic once to help debugging in console (non-blocking)
        try {
            fetchFontDiagnostics().then(r => console.info('[FONT-DIAG] local font fetch results:', r)).catch(e => console.warn('[FONT-DIAG] error', e));
        } catch (e) { /* ignore */ }

        if (document.fonts && document.fonts.load) {
            // try to load the font at a reasonable size
            document.fonts.load('16px "Press Start 2P"').then(() => {
                detectAndLogFontSource().finally(() => launchGame());
            }).catch((err) => {
                // If local font file failed to decode (corrupt file or wrong MIME),
                // attempt a graceful fallback: inject Google Fonts stylesheet and retry.
                console.warn('Font load failed, attempting Google Fonts fallback', err);
                try {
                    if (!document.getElementById('bh-google-font-fallback')) {
                        const gf = document.createElement('link');
                        gf.id = 'bh-google-font-fallback';
                        gf.rel = 'stylesheet';
                        gf.href = 'https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap';
                        document.head.appendChild(gf);
                    }
                } catch (e) { console.warn('Failed to inject Google Fonts link', e); }

                // Retry loading the font from the injected stylesheet, timeout if it still fails
                setTimeout(() => {
                    document.fonts.load('16px "Press Start 2P"').then(() => {
                        detectAndLogFontSource().finally(() => launchGame());
                    }).catch((err2) => {
                        console.warn('Fallback font load failed, launching game anyway', err2);
                        detectAndLogFontSource().finally(() => setTimeout(launchGame, 100));
                    });
                }, 300);
            });
        } else {
            // older browsers: try detection if possible, then launch
            if (window.FontFace || (document && document.body)) {
                detectAndLogFontSource().finally(() => setTimeout(launchGame, 0));
            } else {
                setTimeout(launchGame, 0);
            }
        }

        // Variabili globali
        let player;
        let player2 = null; // second player (if enabled)
        let target;
        let blocks;
        let bullets;
        let cursors;
        let spaceKey;
        let wasdKeys = null; // controls for player2 (WASD + F to shoot)
        // HUD & per-player stats
        let scoreText1, scoreText2;
        let levelText;
        let livesText1, livesText2;
        // per-player scores and lives
        let score1 = 0;
        let score2 = 0;
        let level = 1;
        let lives1 = 3;
        let lives2 = 3;
        // level up threshold tracker (combined points / 500)
        let _levelThreshold = 0;
        let gameStarted = false;
        let targetLifetime = 0;
        let blockSpawnTimer = 0;
        let particles;
        // Credits / player selection
        let credits = 0;
        let playersCount = 1;
        const CREDITS_PER_PLAYER = (window.GAME_CONFIG && window.GAME_CONFIG.CREDITS_PER_PLAYER) || 1;
        // Level/Player select overlay (Phaser objects)
        let selectContainer = null;
        let selectCreditsText = null;
        let selectHintText = null;
        let selectBtn1Text = null;
        let selectBtn2Text = null;
        let selectCancelText = null;
        // Attract / TopTen UI state
        let attractCycleEvent = null;
        let attractVisible = false;
        let attractContainer = null;
        let topTenContainer = null;
        let topTenTitle = null;
        let topTenListContainer = null;
        // Language selector
        const LANGS = ['it', 'fr', 'de', 'en', 'us', 'ja', 'es', 'zh'];
        let currentLangIndex = 0;
        let langFlagImage = null;
        let langTitleText = null;
        let langInstructionsText = null;
        let langStartText = null;
        let topTenCreditsFooter = null;
        // persistent overlay (sprites thumbnails + player indicators) that stays visible
        let uiOverlay = null;
        let spriteThumbsContainer = null;
        let playerIndicator1 = null;
        let playerIndicator2 = null;

        function preload() {
            // Carica risorse usate dalla UI di attract
            this.load.image('attractBg', "images/bg.png");
            this.load.image('flags', 'images/flags.png');
            this.load.image('tileSheet', 'images/tile.png');
            // optional main sprite-sheet with game objects (4x4 grid)
            //this.load.image('spriteSheet', 'images/sprite.png');
            this.load.image('spriteSheet', 'images/objects.png');
        }

        function create() {
            this.cameras.main.setBackgroundColor('#0a0e27');

            // compute sprite cell sizes (if spriteSheet loaded)
            try {
                const st = this.textures.get('spriteSheet');
                if (st && st.source && st.source[0]) {
                    const img = st.source[0].image || st.source[0].data;
                    if (img && img.width && img.height) {
                        spriteCellW = img.width / SHEET_COLS;
                        spriteCellH = img.height / SHEET_ROWS;
                        spriteSheetPad = Math.max(0, Math.round(Math.min(spriteCellW, spriteCellH) * 0.03));
                    }
                }
            } catch (e) { /* ignore */ }



            // Griglia di sfondo
            // const graphics = this.add.graphics();
            // graphics.lineStyle(1, 0x00ffff, 0.1);
            // for (let i = 0; i < 800; i += 40) {
            //     graphics.lineBetween(i, 0, i, 600);
            // }
            // for (let i = 0; i < 600; i += 40) {
            //     graphics.lineBetween(0, i, 800, i);
            // }

            // Schermata Attract (riutilizzabile)
            if (!gameStarted) {
                initAttractUI(this);
                showAttractUI(this);
                return;
            }

            // Player (primary)
            // place players slightly apart to avoid instant overlap
            // Player sprite (primary)
            try {
                // prefer sprite image from spriteSheet when available
                player = this.physics.add.image(300, 550, 'spriteSheet');
                const displaySize = 20;
                if (applySpriteCrop(this, player, 'player')) {
                    player.setDisplaySize(displaySize, displaySize);
                } else {
                    // fallback: colored rectangle replaced by an image tinted
                    player.setDisplaySize(displaySize, displaySize);
                    player.setTint(0x00ff00);
                }
                player.body.setCollideWorldBounds(true);
            } catch (e) {
                // fallback to rectangle if sprite APIs fail
                player = this.add.rectangle(300, 550, 20, 20, 0x00ff00);
                this.physics.add.existing(player);
                player.body.setCollideWorldBounds(true);
            }

            // Optionally create a second player when playersCount >= 2
            if ((playersCount || 1) >= 2) {
                try {
                    player2 = this.physics.add.image(500, 550, 'spriteSheet');
                    const displaySize2 = 20;
                    if (applySpriteCrop(this, player2, 'player')) {
                        player2.setDisplaySize(displaySize2, displaySize2);
                    } else {
                        player2.setDisplaySize(displaySize2, displaySize2);
                        player2.setTint(0x0000ff);
                    }
                    player2.body.setCollideWorldBounds(true);
                } catch (e) {
                    player2 = this.add.rectangle(500, 550, 20, 20, 0x0000ff);
                    this.physics.add.existing(player2);
                    player2.body.setCollideWorldBounds(true);
                }

                // WASD controls for second player, F to shoot
                try {
                    wasdKeys = this.input.keyboard.addKeys({
                        up: Phaser.Input.Keyboard.KeyCodes.W,
                        left: Phaser.Input.Keyboard.KeyCodes.A,
                        down: Phaser.Input.Keyboard.KeyCodes.S,
                        right: Phaser.Input.Keyboard.KeyCodes.D,
                        shoot: Phaser.Input.Keyboard.KeyCodes.F
                    });
                } catch (e) {
                    // fallback for older Phaser input.addKeys signatures
                    const raw = this.input.keyboard.addKeys('W,A,S,D,F');
                    // normalize fallback to the same shape { up,left,down,right,shoot }
                    wasdKeys = {
                        up: raw.W || raw.w,
                        left: raw.A || raw.a,
                        down: raw.S || raw.s,
                        right: raw.D || raw.d,
                        shoot: raw.F || raw.f
                    };
                }
            }

            // Target
            // Target (collectable) — prefer sprite
            try {
                target = this.physics.add.image(0, 0, 'spriteSheet');
                const tSize = 15;
                if (applySpriteCrop(this, target, 'target')) {
                    target.setDisplaySize(tSize, tSize);
                } else {
                    target.setDisplaySize(tSize, tSize);
                    target.setTint(0xffff00);
                }
                spawnTarget(this);
            } catch (e) {
                target = this.add.rectangle(0, 0, 15, 15, 0xffff00);
                this.physics.add.existing(target);
                spawnTarget(this);
            }

            // Gruppi
            blocks = this.physics.add.group();
            bullets = this.physics.add.group();
            // Particles will be represented by small sprite fragments when possible
            particles = this.add.particles(0, 0);

            // Input
            cursors = this.input.keyboard.createCursorKeys();
            spaceKey = this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.SPACE);

            // HUD - per-player
            scoreText1 = this.add.text(16, 16, 'P1: 0', {
                fontSize: '14px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setDepth(100);

            livesText1 = this.add.text(16, 36, 'LIVES: ' + lives1, {
                fontSize: '12px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setDepth(100);

            // right-side HUD for player 2
            scoreText2 = this.add.text(this.scale.width - 16, 16, 'P2: 0', {
                fontSize: '14px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setOrigin(1, 0).setDepth(100);

            livesText2 = this.add.text(this.scale.width - 16, 36, 'LIVES: ' + lives2, {
                fontSize: '12px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setOrigin(1, 0).setDepth(100);

            // Level indicator centered
            levelText = this.add.text(this.scale.width / 2, 16, 'LEVEL: ' + level, {
                fontSize: '14px',
                fontFamily: GAME_FONT,
                fill: '#00ffff'
            }).setOrigin(0.5, 0).setDepth(100);

            // Collisioni - both players should interact with targets/blocks
            this.physics.add.overlap(player, target, collectTarget, null, this);
            this.physics.add.overlap(player, blocks, hitBlock, null, this);
            if (player2) {
                this.physics.add.overlap(player2, target, collectTarget, null, this);
                this.physics.add.overlap(player2, blocks, hitBlock, null, this);
            }
            this.physics.add.overlap(bullets, blocks, destroyBlock, null, this);

            // Apply translations for HUD/select texts if dictionary loaded
            try { applyTranslations(); } catch (e) { /* ignore */ }
        }

        // Initialize attract UI and top-ten container (created once per scene lifecycle)
        function initAttractUI(scene) {
            if (attractContainer) return; // already created for this scene

            const centerX = 400;
            const centerY = 300;

            // Container for attract screen
            attractContainer = scene.add.container(0, 0);

            // Background: usa l'immagine se caricata, altrimenti fallback grafico
            let bg;
            if (scene.textures.exists('attractBg')) {
                bg = scene.add.image(centerX, centerY, 'attractBg');
                bg.setOrigin(0.5, 0.5);
                // Usa dimensione dinamica della scena per coprire il canvas
                bg.setDisplaySize(scene.scale.width || 800, scene.scale.height || 600);
                attractContainer.add(bg);
            } else {
                console.warn('attractBg texture not found — using fallback background');
                bg = scene.add.rectangle(scene.scale.width / 2 || centerX, scene.scale.height / 2 || centerY, scene.scale.width || 800, scene.scale.height || 600, 0x07102a);
                attractContainer.add(bg);

                // leggero overlay scanline per effetto retrò
                const lines = scene.add.graphics();
                lines.lineStyle(1, 0x001020, 0.03);
                for (let y = 0; y < (scene.scale.height || 600); y += 4) {
