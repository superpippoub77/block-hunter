        // Highscore storage helpers (persist to localStorage)
        function getHighscores() {
            try {
                const raw = localStorage.getItem('bh_highscores');
                if (!raw) return [];
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) return [];
                return parsed;
            } catch (e) { return []; }
        }

        function saveHighscoreEntry(entry) {
            try {
                const list = getHighscores();
                list.push(entry);
                // sort desc by score
                list.sort((a, b) => (b.score || 0) - (a.score || 0));
                // keep top 10
                const top = list.slice(0, 10);
                localStorage.setItem('bh_highscores', JSON.stringify(top));
                return top;
            } catch (e) { console.warn('saveHighscore error', e); return getHighscores(); }
        }

        function renderTopTen(scene) {
            if (!topTenListContainer) return;
            // clear existing list children
            try {
                topTenListContainer.removeAll(true);
            } catch (e) { }
            const list = getHighscores();
            const centerX = scene.scale.width / 2 || 400;
            if (!list || !list.length) {
                const emptyText = scene.add.text(centerX, 140, '--- NESSUN PUNTEGGIO ---', { fontSize: '14px', fontFamily: GAME_FONT, fill: '#00ffff' }).setOrigin(0.5);
                topTenListContainer.add(emptyText);
                return;
            }
            const startY = 120;
            for (let i = 0; i < Math.min(10, list.length); i++) {
                const e = list[i];
                const txt = scene.add.text(centerX, startY + i * 28, `${i + 1}. ${e.name || '---'} (${e.player || 'P?'}) - ${e.score}`, { fontSize: '14px', fontFamily: GAME_FONT, fill: '#00ffff' }).setOrigin(0.5);
                topTenListContainer.add(txt);
            }
        }

