{
  "name": "block-hunter",
  "version": "1.0.0",
  "description": "Block Hunter - Arcade game",
  "main": "electron/main.js",
  "scripts": {
    "start": "npx serve -p 8000",
    "start:api": "node server.js",
    "desktop:start": "electron .",
    "build:win": "electron-builder --win",
    "build:win:zip": "electron-builder --win zip --publish=never",
    "generate:asset-manifests": "node tools/generate-asset-manifests.js",
    "cap:init": "npx cap init block-hunter com.example.blockhunter --web-dir=www",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "prepare:www": "rm -rf www && mkdir www && cp -r ./* www && rm -rf www/node_modules || true",
    "generate:icons": "node tools/generate-icons.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.32.0"
  },
  "build": {
    "appId": "com.blockhunter.desktop",
    "productName": "Block Hunter",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!www/**",
      "!android/**",
      "!ios/**",
      "!.git/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
