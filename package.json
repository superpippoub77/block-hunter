{
  "name": "block-hunter",
  "version": "1.0.0",
  "description": "Block Hunter - Arcade game",
  "scripts": {
    "start": "npx serve -p 8000",
    "start:api": "node server.js",
    "generate:data-json": "node tools/generate-data-json.js",
    "generate:asset-manifests": "node tools/generate-asset-manifests.js",
    "cap:init": "npx cap init block-hunter com.example.blockhunter --web-dir=www",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "prepare:www": "rm -rf www && mkdir www && cp -r ./* www && rm -rf www/node_modules || true",
    "generate:icons": "node tools/generate-icons.js",
    "package:install": "npm install --prefix tools/build --no-audit --no-fund",
    "package:web": "node tools/build/build.js web",
    "package:windows": "node tools/build/build.js windows",
    "package:linux": "node tools/build/build.js linux",
    "package:android": "node tools/build/build.js android",
    "package:all": "node tools/build/build.js all"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "sharp": "^0.32.0"
  }
}
