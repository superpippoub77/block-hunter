{
  "id": "level-select",
  "name": "Selezione livello",
  "width": 800,
  "height": 600,
  "duration": 0,
  "loop": false,
  "events": { "start": "GameScene" },
  "background": { "image": "bg", "fit": "cover", "color": "#000000", "overlay": 0.5 },
  "items": [
    { "id": "title", "name": "Titolo", "type": "text", "textKey": "level_select_title", "text": "SELEZIONA DIFFICOLTÀ", "x": 400, "y": 120, "fontSize": 30, "color": "#ffd84a", "strokeThickness": 6, "in": 0,
      "effects": [ { "name": "dropBounce", "at": 0, "duration": 700 } ] },
    { "id": "menu", "name": "Difficoltà", "type": "widget", "widget": "menu", "x": 400, "y": 320, "in": 200,
      "props": { "options": "@beginner | 0.8 | start\n@medium | 1.0 | start\n@hard | 1.3 | start", "stateKey": "difficulty", "fontSize": 30, "spacing": 64 },
      "effects": [ { "name": "fadeIn", "at": 0, "duration": 500 } ] },
    { "id": "hint", "name": "Suggerimento", "type": "text", "text": "↑ ↓  INVIO", "x": 400, "y": 520, "fontSize": 14, "color": "#aaaaaa", "in": 700,
      "effects": [ { "name": "blink", "at": 0, "params": { "period": 1200, "min": 0.3 } } ] }
  ]
}
